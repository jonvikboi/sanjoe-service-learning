// SadanLearn Prisma Schema
// Sanjoe Sadan Convent School LMS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum HomeworkStatus {
  PENDING
  SUBMITTED
  LATE
  REVIEWED
}

enum Priority {
  NORMAL
  HIGH
  URGENT
}

enum TargetRole {
  ALL
  STUDENT
  TEACHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(STUDENT)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student?
  teacher   Teacher?

  @@index([role])
}

model Student {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber String
  grade      String
  section    String
  classId    String?
  class      Class?   @relation(fields: [classId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]
  submissions Submission[]
  studyPlans  StudyPlan[]

  @@index([rollNumber])
}

model Teacher {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments   TeacherAssignment[]
  notes         Note[]
  homework      Homework[]
  announcements Announcement[]
}

model Class {
  id           String   @id @default(uuid())
  name         String
  grade        String
  section      String
  academicYear String
  createdAt    DateTime @default(now())

  students    Student[]
  enrollments Enrollment[]
  assignments TeacherAssignment[]
  notes       Note[]
  homework    Homework[]

  @@unique([grade, section, academicYear])
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  color       String?  @default("#C75A4B")
  iconName    String?  @default("BookOpen")
  createdAt   DateTime @default(now())

  assignments TeacherAssignment[]
  notes       Note[]
  homework    Homework[]
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, classId])
}

model TeacherAssignment {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, classId, subjectId])
}

model Note {
  id             String   @id @default(uuid())
  title          String
  chapter        String
  fileUrl        String
  fileSize       String
  downloadsCount Int      @default(0)
  teacherId      String
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId        String
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([classId, subjectId])
}

model Homework {
  id           String   @id @default(uuid())
  title        String
  instructions String
  dueDate      DateTime
  fileUrl      String?
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions  Submission[]

  @@index([classId, subjectId, dueDate])
}

model Submission {
  id          String         @id @default(uuid())
  homeworkId  String
  homework    Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl     String?
  status      HomeworkStatus @default(SUBMITTED)
  gradeScore  String?
  feedback    String?
  submittedAt DateTime       @default(now())
  reviewedAt  DateTime?

  @@unique([homeworkId, studentId])
}

model Announcement {
  id         String     @id @default(uuid())
  title      String
  content    String
  priority   Priority   @default(NORMAL)
  targetRole TargetRole @default(ALL)
  authorId   String
  author     Teacher    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
}

model StudyPlan {
  id                  String      @id @default(uuid())
  studentId           String
  student             Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title               String
  examDate            DateTime
  availableHoursDaily Float       @default(2.0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tasks               StudyTask[]
}

model StudyTask {
  id              String    @id @default(uuid())
  studyPlanId     String
  studyPlan       StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subjectName     String
  topic           String
  scheduledDate   DateTime
  durationMinutes Int       @default(30)
  completed       Boolean   @default(false)
}

model EducationalContent {
  id          String    @id @default(uuid())
  title       String
  content     String
  category    String
  ageGroup    String?
  imageUrl    String?
  authorId    String?
  published   Boolean   @default(true)
  publishedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
}

model LanguageLesson {
  id              String   @id @default(uuid())
  language        String   // English, Kannada, Hindi
  title           String
  category        String   // Vocabulary, Grammar, Phrases
  contentJson     String   // Structured JSON content
  difficultyLevel String   // Beginner, Intermediate, Advanced
  createdAt       DateTime @default(now())
}

model CareerOpportunity {
  id          String    @id @default(uuid())
  title       String
  description String
  eligibility String?
  deadline    DateTime?
  officialUrl String?
  source      String?
  category    String    // Scholarship, Olympiad, Skill, Government
  createdAt   DateTime  @default(now())
}

model AIRequest {
  id              String   @id @default(uuid())
  userId          String?
  taskType        String   // math, language, study
  inputSnippet    String
  provider        String   // groq, nvidia, gemini, mock
  responseSnippet String?
  createdAt       DateTime @default(now())
}
