# SadanLearn Environment Configuration Template
# Copy this file to .env.local for local development

# MongoDB Database Connection
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="sadanlearn"

# Auth & Session Secret (32+ character random string)
AUTH_SECRET="sadanlearn-super-secret-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Configuration (default: mock)
AI_PROVIDER="mock"
GROQ_API_KEY=""
NVIDIA_API_KEY=""
GEMINI_API_KEY=""

# Optional File Storage Bucket (GridFS / S3)
UPLOAD_STORAGE_BUCKET="sadanlearn-storage"
