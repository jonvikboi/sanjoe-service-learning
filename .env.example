# SadanLearn Environment Configuration Template
# Copy this file to .env.local for development

# Supabase Auth & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# PostgreSQL Database Connection (Supabase Connection Pooler / Direct)
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Optional AI Provider API Keys (for Phase 5)
AI_API_KEY=""
GROQ_API_KEY=""
NVIDIA_API_KEY=""
GEMINI_API_KEY=""
