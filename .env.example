# SadanLearn Environment Configuration Template
# Copy this file to .env.local for local development

# MongoDB Database Connection String
# For local MongoDB: mongodb://localhost:27017/sadanlearn
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sadanlearn?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/sadanlearn"

# Application Authentication Secrets (NextAuth / JWT)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret-key"
JWT_SECRET="replace-with-another-secure-random-jwt-secret"

# Optional Cloud Storage (e.g. Cloudinary / AWS S3 / UploadThing for file attachments)
# Note: Local/GridFS storage can also be used directly within MongoDB
UPLOAD_STORAGE_BUCKET="sadanlearn-storage"

# Optional AI Provider API Keys (for Phase 5)
AI_API_KEY=""
GROQ_API_KEY=""
NVIDIA_API_KEY=""
GEMINI_API_KEY=""
